# ── Base de datos ───────────────────────────────────────────────
# Local: archivo SQLite (libSQL). Producción: URL de Turso (libsql://...).
DATABASE_URL=file:./data/radar.db
# Solo para Turso:
DATABASE_AUTH_TOKEN=

# ── Acceso a la plataforma ──────────────────────────────────────
# Si se define, toda la plataforma pide contraseña (recomendado en producción).
APP_PASSWORD=
# Secreto para firmar la cookie de sesión (32+ caracteres aleatorios).
SESSION_SECRET=

# ── Meta Ad Library API (fuente oficial) ────────────────────────
# Token de usuario o de sistema de una app con acceso a la Ad Library API
# (requiere verificación de identidad en facebook.com/ID).
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v26.0
# Máximo de páginas (de hasta 250 anuncios) por búsqueda monitoreada y ejecución.
META_MAX_PAGES=4

# ── Extensión de Chrome ─────────────────────────────────────────
# Token que la extensión envía como "Authorization: Bearer <token>".
# En desarrollo local, si se deja vacío, se usa "radar-local" (el valor por
# defecto de la extensión). En producción es obligatorio.
INGEST_TOKEN=

# ── Cron (Vercel envía Authorization: Bearer $CRON_SECRET) ──────
CRON_SECRET=

# ── Retención de datos ──────────────────────────────────────────
# Días que se conserva un anuncio no favorito desde la última vez que se vio.
RETENTION_DAYS=180

# ── Clasificación por IA (opcional) ─────────────────────────────
ANTHROPIC_API_KEY=
AI_CLASSIFY_MODEL=claude-opus-5-5
