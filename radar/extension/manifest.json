{
  "manifest_version": 3,
  "name": "Cifra Radar — Puente con la Biblioteca de Anuncios",
  "short_name": "Cifra Radar",
  "version": "0.2.2",
  "description": "Guarda y explora los anuncios reales que ves en la Biblioteca de Anuncios de Meta. Todo queda en tu Chrome; solo captura cuando tú lo pides.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cifra Radar"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/ads/library*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.facebook.com/ads/library*"
      ],
      "js": [
        "src/collector.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
